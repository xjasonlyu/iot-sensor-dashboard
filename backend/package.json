{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "prisma migrate deploy && node dist/server.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "predev": "npm run prisma:generate",
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run prisma:generate",
    "build": "tsc",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iot-dashboard/api-contract": "file:../packages/api-contract",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.6",
    "express": "^4.18.2",
    "express-oauth2-jwt-bearer": "^1.9.1",
    "mqtt": "^5.15.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.4",
    "prisma": "^7.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
